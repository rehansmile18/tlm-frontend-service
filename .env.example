# TLM's own API — the single auth authority for every user (login, User CRUD for the
# Team/Permissions page). Point this at the same TLM instance this app's tenants log into.
NEXT_PUBLIC_TLM_API_BASE_URL=http://localhost:4000/api/v1

# tlm-backend's own API — owns Employee, EmployeeGroup, Site, Task, PayPeriodConfig,
# PayrollCalendar, Punch, EmployeeSiteAssignment, Schedule, and the Timesheet/Processing proxies.
# It accepts the SAME bearer token TLM issues; it has no login of its own.
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:4200/api/v1

# tlm-frontend (the Rule Repository app) — used by the app switcher to link across apps.
NEXT_PUBLIC_RULE_REPO_APP_URL=http://localhost:3000
